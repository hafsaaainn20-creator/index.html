<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Aesthetic Dark Spotify Widget</title>
  <style>
    :root {
      /* Dark Gray / Monochrome Theme Accents */
      --glow-color: #666666;
      --glow-intensity: 20px;
      --border-radius: 18px;
      --bg-color: #181818;
      --scale-hover: 1.015;
      --transition-speed: 0.4s;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Prevents white corners or unwanted white background gaps */
    html, body {
      background: transparent !important;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px;
    }

    /* Container Frame */
    .widget-container {
      position: relative;
      width: 100%;
      max-width: 380px;
      border-radius: var(--border-radius);
      transition: transform var(--transition-speed) ease;
    }

    .widget-container:hover {
      transform: scale(var(--scale-hover));
    }

    /* Dark Silver/Charcoal Pulsing Glow */
    .glow-aura {
      position: absolute;
      top: -4px;
      left: -4px;
      right: -4px;
      bottom: -4px;
      background: radial-gradient(circle, var(--glow-color) 0%, transparent 75%);
      border-radius: calc(var(--border-radius) + 4px);
      filter: blur(var(--glow-intensity));
      opacity: 0.4;
      z-index: 1;
      animation: darkPulse 4s ease-in-out infinite alternate;
      pointer-events: none;
    }

    @keyframes darkPulse {
      0% {
        opacity: 0.2;
        filter: blur(calc(var(--glow-intensity) * 0.8));
      }
      100% {
        opacity: 0.55;
        filter: blur(calc(var(--glow-intensity) * 1.3));
      }
    }

    /* Outer Card Frame - Pure Black & Gray Tone */
    .card-frame {
      position: relative;
      z-index: 2;
      background: var(--bg-color);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.8);
      border-radius: var(--border-radius);
      padding: 6px;
      overflow: hidden;
    }

    /* Spotify Iframe - Removes all default borders and white edges */
    iframe {
      width: 100%;
      height: 352px;
      border: 0 !important;
      outline: none !important;
      border-radius: calc(var(--border-radius) - 4px);
      display: block;
      background: #121212;
    }

    /* Customization Gear Button */
    .customize-btn {
      position: absolute;
      top: 14px;
      right: 14px;
      z-index: 3;
      background: rgba(0, 0, 0, 0.8);
      color: #bbbbbb;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      width: 28px;
      height: 28px;
      font-size: 13px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, transform 0.2s;
    }

    .customize-btn:hover {
      background: rgba(255, 255, 255, 0.15);
      color: #ffffff;
      transform: rotate(45deg);
    }

    /* Settings Panel */
    .control-panel {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(18, 18, 18, 0.96);
      z-index: 4;
      border-radius: var(--border-radius);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      color: #e0e0e0;
      font-size: 12px;
    }

    .control-panel.active {
      opacity: 1;
      pointer-events: all;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 5px;
      font-weight: 600;
      color: #ffffff;
    }

    .close-btn {
      cursor: pointer;
      font-size: 16px;
      color: #888;
    }
    .close-btn:hover { color: #fff; }

    .control-group {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .control-group label { color: #aaa; }

    .control-group input[type="color"],
    .control-group input[type="range"],
    .control-group input[type="text"] {
      background: #282828;
      border: 1px solid #404040;
      color: #fff;
      padding: 3px 6px;
      border-radius: 4px;
    }

    .control-group input[type="text"] {
      width: 60%;
    }
  </style>
</head>
<body>

  <div class="widget-container" id="widget">
    <!-- Dark Glow Effect -->
    <div class="glow-aura" id="glow"></div>

    <!-- Toggle Controls Button -->
    <button class="customize-btn" id="toggleBtn" title="Customize Accent">⚙️</button>

    <!-- Customization Panel Overlay -->
    <div class="control-panel" id="controlPanel">
      <div class="panel-header">
        <span>Theme Customizer</span>
        <span class="close-btn" id="closeBtn">✕</span>
      </div>

      <div class="control-group">
        <label for="colorPicker">Glow Color:</label>
        <input type="color" id="colorPicker" value="#666666">
      </div>

      <div class="control-group">
        <label for="blurSlider">Glow Size:</label>
        <input type="range" id="blurSlider" min="10" max="50" value="20">
      </div>

      <div class="control-group">
        <label for="spotifyUrl">Spotify Embed Link:</label>
        <input type="text" id="spotifyUrl" placeholder="Paste Spotify embed URL...">
      </div>
    </div>

    <!-- Outer Frame -->
    <div class="card-frame">
      <!-- Soft Vocal & Study Focus Tracks -->
      <iframe 
        id="spotifyIframe"
        src="https://open.spotify.com/embed/playlist/37i9dQZF1DX0smO2Bx1A2C?utm_source=generator&theme=0" 
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
        loading="lazy">
      </iframe>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('toggleBtn');
    const closeBtn = document.getElementById('closeBtn');
    const controlPanel = document.getElementById('controlPanel');
    const colorPicker = document.getElementById('colorPicker');
    const blurSlider = document.getElementById('blurSlider');
    const spotifyUrlInput = document.getElementById('spotifyUrl');
    const spotifyIframe = document.getElementById('spotifyIframe');
    const root = document.documentElement;

    toggleBtn.addEventListener('click', () => controlPanel.classList.add('active'));
    closeBtn.addEventListener('click', () => controlPanel.classList.remove('active'));

    colorPicker.addEventListener('input', (e) => {
      root.style.setProperty('--glow-color', e.target.value);
    });

    blurSlider.addEventListener('input', (e) => {
      root.style.setProperty('--glow-intensity', `${e.target.value}px`);
    });

    spotifyUrlInput.addEventListener('change', (e) => {
      let url = e.target.value.trim();
      if (url) {
        if (!url.includes('/embed/')) {
          url = url.replace('spotify.com/', 'spotify.com/embed/');
        }
        spotifyIframe.src = url;
      }
    });
  </script>
</body>
</html>
